{
	# Same filter for ALL logs, also proxy warnings (they contain the full
	# /stream/tts?text=... URL otherwise). G8: no message text in logs.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Do not buffer the audio stream: first audio bytes must reach the app at once.
	reverse_proxy backend:4444 {
		flush_interval -1
	}

	# No message text in the access log (G8): only metadata.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
}
