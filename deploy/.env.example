# Copy to .env on the server (cp .env.example .env) and fill in. NEVER commit .env.
# No quotes, no spaces around "=". deploy.sh stops if a placeholder is left.

# Public domain. DNS A record must point to the server before the first start.
# Example with DuckDNS: myecho-api.duckdns.org
DOMAIN=api.example.com

# Supabase: Project settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (service_role). Only for account deletion (DELETE /account). Never put it into the app.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Supabase: "Connect" > Session pooler (IPv4). NOT the direct connection (IPv6 only).
# User is postgres.<project-ref>. Copy the host from the dialog (aws-0-... or aws-1-...).
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=5

# TTS: mistral (real, costs money) or mock (test, no key needed)
TTS_PROVIDER=mistral
TTS_API_KEY=
TTS_MODEL=voxtral-mini-tts-3-0
TTS_VOICE=
RATE_LIMIT_TTS=30/minute

# Protects /metrics. Create with: openssl rand -hex 32
METRICS_TOKEN=<random>

# Optional: extra CORS origins, comma separated (only needed for a web client)
CORS_ORIGINS=
