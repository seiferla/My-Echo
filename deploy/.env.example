# Copy to .env on the server (cp .env.example .env) and fill in. NEVER commit .env.

# Public domain. DNS A record must point to the VM before the first start.
DOMAIN=api.example.com

# Supabase (Project settings > API / Database)
SUPABASE_URL=https://<project-ref>.supabase.co
# Use the pooler (port 6543 transaction mode or 5432 session mode) from "Connect".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=5

# TTS
TTS_PROVIDER=mistral
TTS_API_KEY=
TTS_MODEL=voxtral-mini-tts-3-0
TTS_VOICE=
RATE_LIMIT_TTS=30/minute

# Protects /metrics (create with: openssl rand -hex 32)
METRICS_TOKEN=

# Optional: extra CORS origins, comma separated
CORS_ORIGINS=
