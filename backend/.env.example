# myEcho Backend — Umgebungsvariablen
# Kopieren nach `.env` (liegt neben docker-compose.yml) und ausfüllen:
#   cp .env.example .env
#
# Hinweis: Bei Deployment über Portainer werden diese Werte stattdessen
# im Stack-Editor unter "Environment variables" gesetzt — dann ist keine
# .env-Datei nötig.

# Fish-Audio API-Key — PFLICHT. Ohne diesen Key liefert das Backend kein TTS.
# Anlegen unter: https://fish.audio  (Account -> API Keys)
TTS_API_KEY=

# TTS-Modell. Default ist s2-pro (kann meist so bleiben).
TTS_MODEL=s2-pro

# Fish-Audio Voice-/Reference-ID der gewünschten Stimme.
# Leer = Standardstimme des Modells.
TTS_VOICE=

# Supabase-Projekt-URL (Dashboard → Connect). Wird für die Token-Prüfung (JWKS) gebraucht.
SUPABASE_URL=https://DEIN_PROJEKT.supabase.co

# Token für /metrics (Prometheus). Ohne Wert ist /metrics geschlossen.
# Gleicher Wert wie METRICS_TOKEN im Monitoring. Erzeugen: openssl rand -hex 32
METRICS_TOKEN=

# Optional: weitere erlaubte Browser-Herkünfte, kommagetrennt (nur für eine Web-Version).
# CORS_ORIGINS=https://app.example.com

# Postgres-Verbindung (Supabase: Connect → Direct / Session pooler). PFLICHT.
# Enthält das Datenbankpasswort: nur hier eintragen, nie committen.
DATABASE_URL=postgresql://postgres:DEIN_PASSWORT@HOST:5432/postgres
