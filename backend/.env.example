# myEcho backend: environment variables
# Copy to `.env` (next to docker-compose.yml) and fill in:
#   cp .env.example .env
# With Portainer, set these values in the stack editor instead.

# Fish Audio API key. REQUIRED, except with TTS_PROVIDER=mock.
# Create one at https://fish.audio (Account -> API Keys).
TTS_API_KEY=

# fish (default, real speech, costs money) or mock (silent MP3 for load tests, no key).
# Any other value stops the start.
TTS_PROVIDER=fish

# Speech requests per signed-in user (not per IP). Set it high for load tests.
# RATE_LIMIT_TTS=30/minute

# Only with TTS_PROVIDER=mock:
# MOCK_TTS_FIRST_AUDIO_MS=1500     delay until the first audio byte
# MOCK_TTS_CHUNK_MS=20             pause between two chunks
# MOCK_TTS_CHARS_PER_SECOND=15     sets the audio length

# TTS model. Default s2-pro.
TTS_MODEL=s2-pro

# Fish Audio voice (reference id). Empty = default voice of the model.
TTS_VOICE=

# Supabase project URL (Dashboard -> Connect). Needed for the token check (JWKS).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Token for /metrics (Prometheus). Empty = /metrics is closed.
# Same value as METRICS_TOKEN in monitoring. Create: openssl rand -hex 32
METRICS_TOKEN=

# Optional: extra browser origins, comma-separated (only for a web version).
# CORS_ORIGINS=https://app.example.com

# Postgres connection (Supabase: Connect -> Direct / Session pooler). REQUIRED.
# Contains the database password: never commit it.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@HOST:5432/postgres
