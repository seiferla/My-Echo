# myEcho Backend — Umgebungsvariablen
# Kopieren nach `.env` (liegt neben docker-compose.yml) und ausfüllen:
#   cp .env.example .env
#
# Hinweis: Bei Deployment über Portainer werden diese Werte stattdessen
# im Stack-Editor unter "Environment variables" gesetzt — dann ist keine
# .env-Datei nötig.

# Mistral-API-Key — PFLICHT. Ohne diesen Key liefert das Backend kein TTS.
# Anlegen unter: https://console.mistral.ai  (API Keys)
TTS_API_KEY=

# TTS-Modell (Voxtral). Default ist Voxtral TTS 3.
TTS_MODEL=voxtral-mini-tts-3-0

# Mistral Voice-ID der gewünschten Stimme (Preset oder Custom Voice).
# Leer = Standardstimme des Modells.
TTS_VOICE=
