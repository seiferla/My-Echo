# myEcho Backend — environment variables
# Copy to .env and fill in: cp .env.example .env
# (Portainer: set these under "Environment variables" instead.)

# Mistral API key (required). https://console.mistral.ai
TTS_API_KEY=

# Voxtral TTS model.
TTS_MODEL=voxtral-mini-tts-3-0

# Voice ID (preset or custom). Empty = model default voice.
TTS_VOICE=
