# Backend-URL für lokale Entwicklung (wird in die App eingebacken).
# Kopieren nach .env und ggf. IP anpassen:
#   cp .env.example .env
#
# In GitHub Actions wird dieser Wert stattdessen über die Repository-Variable
# EXPO_PUBLIC_BACKEND_URL gesetzt (Settings → Secrets and variables → Variables).
EXPO_PUBLIC_BACKEND_URL=http://192.168.178.21:4444
