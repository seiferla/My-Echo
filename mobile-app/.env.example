# Backend URL for local development (built into the app).
# Copy to .env and change the IP if needed:
#   cp .env.example .env
#
# GitHub Actions sets this from the repository variable EXPO_PUBLIC_BACKEND_URL
# (Settings → Secrets and variables → Variables).
EXPO_PUBLIC_BACKEND_URL=http://192.168.178.21:4444

# Supabase login (Dashboard → Connect → Framework). Both values are public.
# NEVER put the secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
