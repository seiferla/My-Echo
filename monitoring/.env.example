# myEcho monitoring (Prometheus + Grafana): environment variables
# Copy to `.env` (next to docker-compose.yml) and fill in:
#   cp .env.example .env
# With Portainer, set these values in the stack editor instead.

# IP or hostname of the Raspberry Pi that runs the backend.
# Used by Grafana (root URL) and Prometheus (scrape target).
# With DHCP, set a static lease for the Pi in the router.
BACKEND_HOST=192.168.178.21

# Token Prometheus uses for /metrics. Same value as METRICS_TOKEN in the backend.
# Use hex characters only, e.g.: openssl rand -hex 32
METRICS_TOKEN=

# Admin password for Grafana.
GRAFANA_PASSWORD=myecho
